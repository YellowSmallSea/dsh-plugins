{
  "name": "@yellowsmallsea/dsh-cot-graph",
  "version": "1.0.0",
  "description": "Graph view of a conversation's reasoning chain, tool calls, and sub-agent dispatches.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YellowSmallSea/dsh-plugins.git",
    "directory": "cot-graph"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-trajectory"
      ]
    }
  }
}