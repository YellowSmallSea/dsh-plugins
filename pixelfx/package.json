{
  "name": "@yellowsmallsea/dsh-pixelfx",
  "version": "1.0.1",
  "description": "Pixel-art VFX library and live preview panel for the DSH Web UI, built on patch-gg/pixelfx.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YellowSmallSea/dsh-plugins.git",
    "directory": "pixelfx"
  },
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}